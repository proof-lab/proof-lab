# Data – raw / processed data is NOT tracked in Git
data/raw/
data/processed/
data/cache/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Artefacts – model files, reports etc. are NOT tracked in Git
artifacts/models/
artifacts/experiments/
artifacts/reports/
!artifacts/models/.gitkeep
!artifacts/experiments/.gitkeep
!artifacts/reports/.gitkeep

# DuckDB
*.duckdb
*.duckdb.wal

# Trash
trash/