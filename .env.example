# Proof Lab – environment variable reference
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must NEVER be committed.

# ── Runtime environment ───────────────────────────────────────────────────
# Which YAML overlay to load: development | testing | production
PROOFLAB_ENV=development

# ── Logging ──────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
PROOFLAB_LOG__LEVEL=INFO
# Log format: text (Rich, human-readable) | json (machine-readable)
PROOFLAB_LOG__FORMAT=text

# ── Data paths ────────────────────────────────────────────────────────────
PROOFLAB_DATA__RAW_DIR=data/raw
PROOFLAB_DATA__PROCESSED_DIR=data/processed
PROOFLAB_DATA__CACHE_DIR=data/cache

# ── Database ──────────────────────────────────────────────────────────────
PROOFLAB_DB__URL=duckdb:///data/prooflab.duckdb

# ── Broker / exchange credentials (future milestones) ────────────────────
# BROKER_API_KEY=<your-key>
# BROKER_API_SECRET=<your-secret>

# ── Safety gate ───────────────────────────────────────────────────────────
# DO NOT set this to true here. Live trading requires an explicit
# programmatic gate and cannot be enabled through configuration alone.
# PROOFLAB_LIVE_TRADING_ENABLED=false
